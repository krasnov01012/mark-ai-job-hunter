MARK_TELEGRAM_CHAT_ID=
GENERIC_TIMEZONE=Europe/Moscow

# Required for the trusted MARK workflow to read MARK_TELEGRAM_CHAT_ID in n8n 2.x.
# Do not enable this on an instance that runs untrusted workflows.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Optional instance-wide guard for a dedicated MARK n8n instance.
# Do not set this on a shared instance without reviewing other workflows.
N8N_CONCURRENCY_PRODUCTION_LIMIT=1
