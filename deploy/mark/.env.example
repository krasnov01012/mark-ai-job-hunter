# Runtime images. Keep n8n and migration CLI on the same verified version.
N8N_VERSION=2.29.10
POSTGRES_VERSION=16-alpine

# PostgreSQL is private to the Compose network.
POSTGRES_DB=n8n
POSTGRES_USER=mark_n8n
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE

# Copy the exact source-instance key when importing encrypted credentials.
# A different key makes the imported credentials unreadable.
N8N_ENCRYPTION_KEY=CHANGE_ME_COPY_THE_SOURCE_N8N_ENCRYPTION_KEY

# MARK runtime contract.
MARK_TELEGRAM_CHAT_ID=CHANGE_ME_SET_THE_PRIVATE_CHAT_ID
GENERIC_TIMEZONE=Europe/Moscow
MARK_BIND_PORT=5678
MIGRATION_REQUIRED=true

# Public URL managed by the host reverse proxy. Replace the example domain.
N8N_HOST=mark.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://mark.example.com/
N8N_EDITOR_BASE_URL=https://mark.example.com/
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true

# Bounded execution storage and daily local backups.
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=1000
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
